rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /pieces/{pieceId} {
      allow read: if resource.data.published == true || request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.published is bool;
      allow update, delete: if request.auth != null;
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.color is string;
      allow delete: if request.auth != null;
    }

    match /responses/{responseId} {
      allow read, delete: if request.auth != null;
      allow create: if request.resource.data.keys().hasOnly(['pieceId', 'createdAt'])
        && request.resource.data.pieceId is string
        && request.resource.data.createdAt is timestamp
        && exists(/databases/$(database)/documents/pieces/$(request.resource.data.pieceId))
        && get(/databases/$(database)/documents/pieces/$(request.resource.data.pieceId)).data.published == true;
      allow update: if false;
    }
  }
}
